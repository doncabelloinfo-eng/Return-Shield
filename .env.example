# ---------------------------------------------------------------------------
# Return Shield — every key the app reads. Copy to .env and fill in.
# Nothing here is committed with a real value.
#
# Only the first four are required. With DATABASE_URL, SESSION_SECRET,
# CRON_SECRET and APP_URL set, the app boots and every screen renders; the
# Settings screen shows which integrations are not connected yet and what each
# one costs. See docs/deploying.md.
# ---------------------------------------------------------------------------

# Postgres
DATABASE_URL=postgres://returnshield:returnshield@localhost:5432/return_shield

# Where this app is reachable from the outside. Used to build /e/{token} links
# that go into customer messages, so it must be the public URL, not localhost.
APP_URL=https://shield.example.com

# Signs login sessions and the public customer action tokens. 32+ random bytes.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Authorises the scheduled jobs. YOU set this by hand — Vercel does not
# generate it. Add it as a project environment variable and Vercel then sends
# it as `Authorization: Bearer $CRON_SECRET` on every cron invocation.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Without it every cron route refuses every request — an open endpoint that
# sweeps the shipment table and emails the team is worse than a job that never
# runs. The consequence is a working dashboard with no engine behind it, so the
# panel shows a banner when nothing has run recently.
CRON_SECRET=

# LOCAL ONLY. `TZ` is a reserved variable on Vercel and cannot be set there —
# production runs in UTC. Nothing depends on it: lib/time.ts does its own
# Europe/Madrid arithmetic with Intl, and the test suite pins TZ=UTC so it
# exercises the same configuration production does. Setting it locally only
# makes your own logs easier to read.
TZ=Europe/Madrid

# --- Correos trackpub (outbound: we call them) -----------------------------
# This is how tracking reaches us. Push (Track&TracePush) is not configured, so
# the reconcile sweep is not a safety net — it is the only source of events.
#
# Two separate credential pairs, from two different places, and it is easy to
# mix them up:
#
#   CORREOS_CLIENT_ID / _SECRET        the API GATEWAY credentials, from the
#                                      developer-portal app ("Return Shield",
#                                      trackpub 2.0 contract). Sent as the
#                                      client_id and client_secret headers.
#
#   CORREOS_OAUTH_CLIENT_ID / _SECRET  the CorreosID system-user application
#                                      credentials. Exchanged for the bearer
#                                      token. NOT the same as the pair above.
CORREOS_CLIENT_ID=
CORREOS_CLIENT_SECRET=
CORREOS_OAUTH_CLIENT_ID=
CORREOS_OAUTH_CLIENT_SECRET=

# Defaults are production. Pre-production is apioauthcid.correospre.es and
# api1.correospre.es.
CORREOS_TOKEN_URL=https://apioauthcid.correos.es/Api/Authorize/Token
CORREOS_OAUTH_SCOPE=AP3 LBS RCG
CORREOS_TRACKPUB_BASE_URL=https://api1.correos.es/support/trackpub/api/v2

# Which response field holds the JWT. Default: idToken, then access_token.
# Only set this if Correos change the shape of the token response.
CORREOS_OAUTH_RESPONSE_FIELD=

# A token pasted in by hand, for testing only. When set it bypasses the token
# endpoint entirely and is used as-is until it expires. Leave empty in
# production — a 30-minute token is not a credential you can configure.
CORREOS_JWT=

# --- Correos Track&TracePush (inbound: they call us) -----------------------
# The credentials Correos sends in the clientID / clientSecret headers.
CORREOS_PUSH_CLIENT_ID=
CORREOS_PUSH_CLIENT_SECRET=
# Comma-separated source IPs Correos will call from. Empty disables the check —
# acceptable behind a proxy that already filters, never on a public host.
CORREOS_PUSH_ALLOWED_IPS=

# --- Shopify --------------------------------------------------------------
# One block per store. STORE_KEY is the slug in /api/webhooks/shopify/{store}
# and must match the `key` column in the stores table.
# SHOPIFY_<STORE_KEY>_WEBHOOK_SECRET   HMAC secret for webhook verification
# SHOPIFY_<STORE_KEY>_ACCESS_TOKEN     Admin API token, used by the backfill
# SHOPIFY_<STORE_KEY>_SHOP_DOMAIN      e.g. my-store.myshopify.com
SHOPIFY_MAINSTORE_WEBHOOK_SECRET=
SHOPIFY_MAINSTORE_ACCESS_TOKEN=
SHOPIFY_MAINSTORE_SHOP_DOMAIN=

# --- WhatsApp (Step 2 — leave empty and the app stays in copy-paste mode) --
# none = no provider, operator copies the message and taps the wa.me link.
WHATSAPP_PROVIDER=none
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# --- Email (daily digest, internal alerts) --------------------------------
# Leave SMTP_HOST empty to log digests to stdout instead of sending.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Return Shield <shield@example.com>"
MAIL_TO=

# --- Tuning (optional) ----------------------------------------------------
# Connections per instance. Serverless runs many short-lived instances against
# one database, so each holds a small pool. Defaults: 3 on Vercel, 10 elsewhere.
DB_POOL_MAX=

# The reconcile sweep: how many parcels per run, and how long it may spend
# starting lookups. Both sit inside the route's maxDuration so a run always
# ends by choice rather than by being killed mid-sweep.
RECONCILE_BATCH_SIZE=200
RECONCILE_BUDGET_MS=45000

# --- Dev only -------------------------------------------------------------
# 1 enables the seeded demo data and the clock's +1 day / +1 hour controls.
# Never set this in production: it lets anyone move the escalation clock.
DEMO_MODE=0
